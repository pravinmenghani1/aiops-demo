# Copy this file to .env and fill in ONE provider block. Never commit .env.

# Which LLM to use: openai | azure | bedrock
LLM_PROVIDER=openai

# 0 = most repeatable answers. If your model only accepts its default, the kit drops it automatically.
LLM_TEMPERATURE=0

# ---- OpenAI, or any OpenAI-compatible endpoint ---------------------------------
OPENAI_API_KEY=
LLM_MODEL=                       # any current chat model that supports tool (function) calling
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# Ollama on your own laptop (no key needed, pick a tool-capable model):
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen2.5:7b
#
# Google Gemini through its OpenAI-compatible endpoint:
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_API_KEY=<your Gemini API key>
#   LLM_MODEL=<a Gemini model name>

# ---- Azure OpenAI ---------------------------------------------------------------
# LLM_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=<your deployment name, not the model name>
# AZURE_OPENAI_API_VERSION=2024-10-21

# ---- Amazon Bedrock (needs: pip install boto3; uses your normal AWS credentials) -
# LLM_PROVIDER=bedrock
# AWS_REGION=us-east-1
# LLM_MODEL=<a model ID or inference profile ID that supports tool use and is enabled in your account>

# ---- Corporate network -----------------------------------------------------------
# HTTPS_PROXY=http://proxy.example.com:8080
# SSL_CERT_FILE=/path/to/corporate-root-ca.pem

# Uncomment to make every demo use scripted responses (no LLM calls at all):
# AGENT_MODE=mock
