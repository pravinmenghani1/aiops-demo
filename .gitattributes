# Keep Unix line endings for everything that runs inside Linux containers or is diffed in
# training material, so a Windows checkout (core.autocrlf=true) cannot break the lab.
*.sh          text eol=lf
*.py          text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.xml         text eol=lf
*.txt         text eol=lf
*.ini         text eol=lf
*.json        text eol=lf
Dockerfile    text eol=lf
.env*         text eol=lf
