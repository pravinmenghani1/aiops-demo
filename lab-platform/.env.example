# AgentOps Lab settings. `python3 labctl.py init` copies this to .env and fills in the secrets.
# Keep .env private and never commit it.

# ---- Generated by labctl init ------------------------------------------------
JENKINS_ADMIN_PASSWORD=
JENKINS_AGENT_PASSWORD=
OPS_TOKEN=
SERVICES_ADMIN_TOKEN=
BUILD_AGENT_PUBKEY=

# ---- Agent behaviour ----------------------------------------------------------
GUARDRAILS=on
APPROVAL_TIMEOUT_SECONDS=600
AGENT_MAX_STEPS=10
# Rehearsal mode: the real systems with a scripted agent and no LLM calls. Remove to use your LLM.
# AGENT_MODE=mock

# ---- LLM ----------------------------------------------------------------------
# The agent reads the LLM settings from ../.env, the same file the Module 1 demos use.
# Anything you set here wins. Ollama on this Mac must be reached through host.docker.internal:
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# For Amazon Bedrock also set INSTALL_BOTO3=true and AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION.

# ---- GitHub Actions (optional; `python3 labctl.py github` fills these in) -----
GITHUB_REPO=
GITHUB_TOKEN=
